{
  "name": "@naivi/compiler",
  "version": "0.0.1",
  "description": "AOT compiler for naive — Vue SFC to RenderTree IR + Style IR",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaiSiuKei/naivi.git",
    "directory": "js/naivi-compiler"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.4.0",
    "postcss": "^8.5.22",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
